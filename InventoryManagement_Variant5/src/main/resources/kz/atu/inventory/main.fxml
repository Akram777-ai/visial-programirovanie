<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="kz.atu.inventory.MainController" style="-fx-background-color:#f3f7fb;">
 <top><VBox><MenuBar><menus><Menu text="Файл"><items><MenuItem text="Сохранить (Ctrl+S)" onAction="#save"/></items></Menu><Menu text="Товары"><items><MenuItem text="Добавить (Ctrl+N)" onAction="#add"/><MenuItem text="Редактировать" onAction="#edit"/><MenuItem text="Удалить" onAction="#delete"/></items></Menu><Menu text="Справка"><items><MenuItem text="О программе" onAction="#about"/></items></Menu></menus></MenuBar><HBox spacing="12" style="-fx-background-color:#16324f;-fx-padding:18;"><Label text="СКЛАД · INVENTORY MANAGEMENT" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:white;"/></HBox><ToolBar><Button text="+ Добавить" onAction="#add"/><Button text="Редактировать" onAction="#edit"/><Button text="Удалить" onAction="#delete"/><Separator orientation="VERTICAL"/><Button text="↓ Поступление" onAction="#receive"/><Button text="↑ Списание" onAction="#issue"/><Separator orientation="VERTICAL"/><Button text="Сохранить" onAction="#save"/></ToolBar></VBox></top>
 <center><VBox spacing="12" style="-fx-padding:22;"><HBox spacing="12"><Label text="Поиск:"/><TextField fx:id="searchField" promptText="Название или ID" prefWidth="280"/><Label text="Категория:"/><ComboBox fx:id="categoryBox" prefWidth="210"/></HBox><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="idCol" text="ID" prefWidth="85"/><TableColumn fx:id="nameCol" text="Товар" prefWidth="310"/><TableColumn fx:id="catCol" text="Категория" prefWidth="210"/><TableColumn fx:id="qtyCol" text="Остаток" prefWidth="140"/><TableColumn fx:id="priceCol" text="Цена (₸)" prefWidth="180"/></columns></TableView><Label fx:id="summaryLabel" style="-fx-font-size:14;-fx-font-weight:bold;"/></VBox></center>
 <bottom><HBox style="-fx-background-color:#dfe9f2;-fx-padding:10;"><Label fx:id="statusLabel" text="Готово"/></HBox></bottom>
</BorderPane>